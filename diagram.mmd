end

subgraph group_console["NES emulation"]
  node_nes["NES console<br/>[NES.cpp]"]
  node_bus["System bus<br/>[Bus.cpp]"]
  node_cpu["CPU<br/>[CPU.cpp]"]
  node_ppu["PPU video<br/>[PPU.cpp]"]
  node_apu["APU audio<br/>[APU.cpp]"]
  node_ram[("System RAM<br/>[RAM.cpp]")]
  node_vram[("Video RAM<br/>[VRAM.cpp]")]
  node_controllers["Controllers and Zapper<br/>[Controller.h]"]
end

subgraph group_media["Cartridge support"]
  node_cartridge["Cartridge loader<br/>[Cartridge.cpp]"]
  node_mappers["Mapper implementations"]
end

subgraph group_inspection["Debug tools"]
  node_debug["Debug window manager"]
  node_viewers["Hardware viewers<br/>[OamViewer.cpp]"]
  node_disassembler["CPU disassembler<br/>[Disassembler.cpp]"]
end

node_user(("Player"))
node_rom["ROM or ZIP"]

node_user -.->|"operates"| node_window
node_rom -.->|"loads"| node_cartridge
node_window -.->|"requests emulation"| node_engine
node_engine -.->|"advances console"| node_nes
node_engine -->|"owns"| node_window
node_engine -->|"owns"| node_nes
node_engine -->|"owns"| node_input
node_engine -->|"owns"| node_audio
node_input -.->|"sets controls"| node_nes
node_engine -.->|"manages output"| node_audio
node_engine -->|"owns"| node_states
node_engine -->|"stores"| node_rewind
node_states -.->|"loads ROMs and saves or restores state"| node_nes
node_rewind -.->|"captures and restores snapshots"| node_nes
node_window -.->|"persists preferences"| node_config
node_nes -->|"owns"| node_bus
node_nes -->|"owns"| node_cpu
node_nes -->|"owns"| node_ppu
node_nes -->|"owns"| node_apu
node_nes -->|"owns"| node_ram
node_nes -->|"owns"| node_controllers
node_nes -.->|"loads cartridge"| node_cartridge
node_cpu <-.->|"CPU memory access"| node_bus
node_ppu <-.->|"PPU registers and cartridge access"| node_bus
node_apu <-.->|"APU registers and DMC access"| node_bus
node_bus -.->|"reads and writes"| node_ram
node_bus -.->|"reads controls and writes strobe"| node_controllers
node_bus -->|"holds shared ownership"| node_cartridge
node_bus -.->|"routes cartridge access"| node_cartridge
node_ppu -->|"owns"| node_vram
node_cartridge -->|"owns selected mapper"| node_mappers
node_apu -.->|"supplies emulated audio"| node_audio
node_window -->|"owns"| node_debug
node_debug -->|"owns viewers"| node_viewers
node_debug -->|"owns"| node_disassembler
node_viewers -.->|"inspects video state"| node_ppu

subgraph group_legend["Legend"]
  legend_owner["Owner"] -->|"owns / stores"| legend_owned["Component or data"]
  legend_source["Caller / source"] -.->|"calls / access / data flow"| legend_target["Receiver"]
end

