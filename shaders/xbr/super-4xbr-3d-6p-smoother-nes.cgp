# The 3D preset expects an input already rendered at 4x internal resolution.
# Expand the NES framebuffer with nearest-neighbor before the original passes.
shaders = 8
shader0 = ../stock.cg
filter_linear0 = false
scale_type0 = source
scale0 = 4.0

shader1 = shaders/super-xbr/super-4xbr-3d-pass0.cg
filter_linear1 = false
scale_type1 = source
scale1 = 1.0
shader2 = shaders/super-xbr/super-4xbr-3d-pass1.cg
filter_linear2 = false
scale_type2 = source
scale2 = 1.0
shader3 = shaders/super-xbr/super-4xbr-3d-pass1f.cg
filter_linear3 = false
scale_type3 = source
scale3 = 1.0
shader4 = shaders/super-xbr/super-4xbr-3d-pass2.cg
filter_linear4 = false
scale_type4 = source
scale4 = 1.0
shader5 = shaders/super-xbr/super-4xbr-3d-pass3.cg
filter_linear5 = false
scale_type5 = source
scale5 = 1.0
shader6 = shaders/super-xbr/super-4xbr-3d-pass3f.cg
filter_linear6 = false
scale_type6 = source
scale6 = 1.0
shader7 = ../stock.cg
filter_linear7 = true
